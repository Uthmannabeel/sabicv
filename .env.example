# Google Gemini (Google Cloud requirement for XPRIZE)
GEMINI_API_KEY=

# Payment mode: "transfer" (bank transfer + owner confirm) or "paystack"
NEXT_PUBLIC_PAYMENT_MODE=transfer

# Bank-transfer mode: the account customers pay into
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# Admin screen key (long random string, 16+ chars)
ADMIN_TOKEN=

# Paystack (only needed when NEXT_PUBLIC_PAYMENT_MODE=paystack)
PAYSTACK_SECRET_KEY=

# Public URL of the deployed site, no trailing slash (used for payment
# callbacks and email links), e.g. https://sabicv.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Email delivery via Resend — optional; downloads work without it
RESEND_API_KEY=
EMAIL_FROM="SabiCV <hello@sabicv.com>"
